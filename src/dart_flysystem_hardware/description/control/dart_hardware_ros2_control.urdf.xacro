<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="dart_servo_ros2_control" params="name prefix">
        <xacro:property name="PI" value="3.1415926535897931" />
        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>dart_flysystem_hardware/DartFlySystemHardwareActuator</plugin>
                <param name="debug">true</param>
                <param name="offset_angle">${PI/2}</param>
            </hardware>

            <joint name="${prefix}base_link_to_servoLU_joint">
                <command_interface name="position">
                </command_interface>
                <param name="min">${-PI/8}</param>
                <param name="max">${PI/8}</param>
                <state_interface name="position" />
                <!-- pwm14@fe700020 -->
                <param name="pwm_chip">4</param>
                <param name="pwm_channel">0</param>
            </joint>

            <joint name="${prefix}base_link_to_servoLD_joint">
                <command_interface name="position">
                </command_interface>
                <param name="min">${-PI/8}</param>
                <param name="max">${PI/8}</param>
                <state_interface name="position" />
                <!-- pwm15@fe700030 -->
                <param name="pwm_chip">5</param>
                <param name="pwm_channel"> 0</param>
            </joint>

            <joint name="${prefix}base_link_to_servoRU_joint">
                <command_interface name="position">
                </command_interface>
                <param name="min">${-PI/8}</param>
                <param name="max">${PI/8}</param>
                <state_interface name="position" />
                <!-- pwm12@fe700000 -->
                <param name="pwm_chip">2</param>
                <param name="pwm_channel"> 0</param>
            </joint>

            <joint name="${prefix}base_link_to_servoRD_joint">
                <command_interface name="position">
                </command_interface>
                <param name="min">${-PI/8}</param>
                <param name="max">${PI/8}</param>
                <state_interface name="position" />
                <!-- pwm13@fe700010 -->
                <param name="pwm_chip">3</param>
                <param name="pwm_channel"> 0</param>
            </joint>

            <joint name="${prefix}base_link_to_throttle_joint">
                <command_interface name="velocity">
                </command_interface>
                <state_interface name="velocity" />
                <!-- pwm9@fe6f0010 -->
                <param name="pwm_chip">1</param>
                <param name="pwm_channel"> 0</param>
                <param name="default_velocity">0</param>
                <param name="max_velocity_duty_cycle_percentage">99</param>
                <param name="min_velocity_duty_cycle_percentage">60</param>
                <param name="pwm_frequency">500</param>
            </joint>

        </ros2_control>
    </xacro:macro>
    <xacro:macro name="dart_encoder_ros2_control" params="name prefix">
        <!-- Wind wing sensor -->
        <ros2_control name="${name}" type="sensor">
            <hardware>
                <plugin>dart_flysystem_hardware/DartFlySystemHardwareEncoder</plugin>
                <param name="i2c_device">/dev/i2c-4</param>
                <param name="i2c_address">0x36</param>
                <param name="encoder_raw_offset">0</param>
                <!-- encoder_offset直接作用于原始角度值，单位是4096/rad -->
                <param name="dart_i2c_en_path">/sys/class/leds/dart-i2c-en/brightness</param>
            </hardware>

            <sensor name="${prefix}encoder">
                <state_interface name="position" />
                <state_interface name="velocity" />
            </sensor>

        </ros2_control>

    </xacro:macro>
    
    <xacro:macro name="dart_imu_ros2_control" params="name prefix">
        <!-- IMU and wind wing sensor -->
        <ros2_control name="${name}" type="sensor">
            <hardware>
                <plugin>dart_flysystem_hardware/DartFlySystemHardwareIMU</plugin>
                <param name="serial_file">/dev/ttyS3</param>
                <param name="baudrate">230400</param>
                <param name="imu_address">80</param>
            </hardware>

            <sensor name="${prefix}imu">
                <state_interface name="linear_acceleration.x" />
                <state_interface name="linear_acceleration.y" />
                <state_interface name="linear_acceleration.z" />
                <state_interface name="angular_velocity.x" />
                <state_interface name="angular_velocity.y" />
                <state_interface name="angular_velocity.z" />
                <state_interface name="orientation.x" />
                <state_interface name="orientation.y" />
                <state_interface name="orientation.z" />
                <state_interface name="orientation.w" />
            </sensor>
        </ros2_control>
        
    </xacro:macro>
</robot> 