{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "(gdb) Ros2 Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/install/lib/${input:package_name}/${input:package_executable}", 
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/opt/ros/jazzy/lib:${workspaceFolder}/install/lib:${workspaceFolder}/install/dart_controller/lib:$LD_LIBRARY_PATH"
                }
            ],
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                // {
                //     "description": "Set Disassembly Flavor to Intel",
                //     "text": "-gdb-set disassembly-flavor intel",
                //     "ignoreFailures": true
                // }
            ]
        }
    ],
    "inputs": [
        {
            "id": "package_name",
            "type": "promptString",
            "description": "ros2 package name",
            "default": "dart_controller"
        },
        {
            "id": "package_executable",
            "type": "promptString",
            "description": "ros2 package executable",
            "default": "node_lvgl_ui"
        }
    ]
}